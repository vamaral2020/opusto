# Application
NODE_ENV=development
SITE_URL=http://localhost:3000
PAYLOAD_SECRET=generate-a-long-random-secret
DATABASE_URL=postgresql://opusto:change-me@postgres:5432/opusto
MEDIA_DIR=media
MAX_UPLOAD_BYTES=10000000
BUILD_SHA=development

# PostgreSQL (Docker Compose)
POSTGRES_DB=opusto
POSTGRES_USER=opusto
POSTGRES_PASSWORD=change-me

# Production image and domain
APP_DOMAIN=example.com
IMAGE_REF=ghcr.io/owner/opusto:commit-sha
APP_PORT=3000
POSTGRES_PORT=5432

# Contact protection
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Restic / S3-compatible backups (not activated automatically)
RESTIC_REPOSITORY=s3:https://s3.example.com/bucket/opusto
RESTIC_PASSWORD=generate-a-long-random-secret
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=us-east-1
BACKUP_REQUIRED=false
BACKUP_STAGING_DIR=/var/backups/opusto
RESTIC_IMAGE=restic/restic:0.18.1
