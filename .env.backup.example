# Docker env-file syntax: literal KEY=value, no quotes, export or interpolation.
# Copy to /opt/opusto/.env.backup (root:root, 0600). Never commit real credentials.
# Keep the EXACT existing repository path/prefix; the R2 repository is already initialized.
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/opusto-backups
RESTIC_PASSWORD=replace-with-existing-repository-password
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
AWS_DEFAULT_REGION=auto
# Optional confidential base ping URL; leave empty to disable monitoring.
# Never commit a real URL. Only the host script uses this value.
HEALTHCHECKS_PING_URL=
