{
  "name": "opusto",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional e CMS do Grupo Musical Opus Tocantins",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings=0",
    "migrate": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm test:int",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "typecheck": "tsc --noEmit",
    "test:cms": "cross-env NODE_OPTIONS=--no-deprecation NODE_ENV=test PAYLOAD_DISABLE_PUSH=true tsx tests/integration/cms-images.ts",
    "test:security:linux": "docker build -f tests/security/Dockerfile -t opusto-security-test .",
    "test:security": "python3 -m unittest discover -s tests/security -v",
    "test:backup": "tsx tests/integration/backup-restic.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "10.1.0",
    "dotenv": "16.4.7",
    "graphql": "16.11.0",
    "lucide-react": "0.563.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "jsdom": "28.0.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.4"
  }
}
