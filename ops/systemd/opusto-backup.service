[Unit]
Description=Opus TO encrypted PostgreSQL and media backup to Cloudflare R2
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/opusto
Environment=DEPLOY_DIR=/var/lib/opusto
Environment=ENV_FILE=/etc/opusto/.env
Environment=BACKUP_ENV_FILE=/etc/opusto/.env.backup
Environment=COMPOSE_FILE=/etc/opusto/compose.prod.yaml
ExecStart=/usr/local/libexec/opusto/backup.sh scheduled
UMask=0077
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
